{
	"core": "WordPress/WordPress#7.1.3",
	"phpVersion": "8.4",
	"themes": [
		"https://downloads.wordpress.org/theme/twentytwentyfive.1.4.zip"
	],
	"plugins": [
		".",
		"https://downloads.wordpress.org/plugin/query-monitor.3.16.4.zip"
	],
	"mappings": {
		"wp-content/mu-plugins": "./tests/e2e/mu-plugins"
	},
	"port": 8877,
	"testsPort": 8878,
	"lifecycleScripts": {
