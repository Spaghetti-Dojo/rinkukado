{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "rinkukado/example",
	"version": "0.1.0",
	"title": "Rinkukado Example",
	"category": "widgets",
	"description": "An example dynamic block driven by the Interactivity API.",
	"textdomain": "rinkukado",
	"supports": {
		"html": false,
		"interactivity": true,
		"inserter": false
	},
	"attributes": {
		"label": {
			"type": "string",
			"default": "Count"
		},
		"start": {
			"type": "number",
			"default": 0
		}
	},
	"viewScriptModule": "file:./view.js",
	"style": "file:./style-view.css",
	"render": "file:./render.php"
}
